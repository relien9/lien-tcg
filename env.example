# Copy this to .env.local (Vercel picks this up automatically) or set the
# same names as Environment Variables in the Vercel project settings.
# Get these from portal.vipps.no → your sales unit → API keys / Developer.

# "test" while you're testing with the Vipps test app, "production" when live.
VIPPS_ENV=test

VIPPS_CLIENT_ID=
VIPPS_CLIENT_SECRET=
VIPPS_SUBSCRIPTION_KEY=
VIPPS_MSN=

# Set after registering the webhook (see README) — the secret returned by
# POST /webhooks/v1/webhooks. Required for api/vipps/callback.js to accept events.
VIPPS_WEBHOOK_SECRET=

# Optional — your site's own URL, used to build the Vipps return URL.
# If unset, it's derived from the request's Host header, which normally works fine.
SITE_URL=https://lientcg.no

# --- Order confirmation e-post (post@lientcg.no) ---
# Get an API key from resend.com (free tier: 3000 e-poster/mnd). See README.md
# "Om e-postbekreftelse" for domeneverifisering (SPF/DKIM hos domene.no), uten
# det vil Resend nekte å sende fra post@lientcg.no.
RESEND_API_KEY=

# Optional — defaults shown below if left unset.
RESEND_FROM=LIEN TCG <post@lientcg.no>
ORDER_NOTIFICATION_EMAIL=post@lientcg.no
